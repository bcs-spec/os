#include <stdio.h>

void main()
{
  int n,size,head,i,total=0,x=0,flag,abs();
  void sort(int[], int);
  printf("\nHow many requests: ");
  scanf("%d",&n);
  int a[n+3];
  printf("Enter actual requests: ");
  for(i=1; i<=n; i++)
    scanf("%d",&a[i]);
  printf("Enter initial head location: ");
  scanf("%d",&head);
  a[0]=head;
  printf("Enter disk size: ");
  scanf("%d",&size);
  printf("Enter direction (Left=0, Right=1): ");
  scanf("%d",&flag);
  a[n+1]=0;
  a[n+2]=size-1;
  sort(a,n+3);
printf("\n Sorted Elements: \n");
for(i=0; i<n+3; i++)
printf("\t%d",a[i]);
printf("\n");
  while(a[x]!=head)
    x++;
  if(flag)
  {
    for(i=x; i<n+2; i++)
      total += abs(a[i]-a[i+1]);
    for(i=0; i<x-1; i++)
      total += abs(a[i]-a[i+1]);
  }
  else
  {
    for(i=x; i>0; i--)
      total += abs(a[i]-a[i-1]);
    total += abs(a[i]-a[n+2]);
    for(i=n+2; i>x+1; i--)
      total += abs(a[i]-a[i-1]);
  }
  printf("\n*** Total Head Movements: %d\n",total);
}

void sort(int a[], int n)
{
  int i,j,temp;
  for(i=0; i<n; i++)
    for(j=0; j<n-1; j++)
    {
      if(a[j]>a[j+1])
      {
        temp=a[j];
        a[j]=a[j+1];
        a[j+1]=temp;
      }
    }
}
